{
  "name": "nusantara-languages",
  "version": "0.1.0",
  "private": true,
  "description": "Language map of Indonesia: family-coloured speaker areas with the genealogical tree bound to the plate.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm sources:validate && next build && node scripts/postbuild.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integrity": "vitest run tests/integrity",
    "test:licence": "vitest run tests/licence",
    "sources:fetch": "tsx scripts/fetch-sources.ts",
    "sources:build": "tsx scripts/build-sources.ts",
    "sources:validate": "tsx scripts/validate-sources.ts",
    "bench:plate": "tsx scripts/bench-plate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.2"
  }
}
